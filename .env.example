NODE_ENV=development
PORT=3000
FRONTEND_URL=http://localhost:3000
MONGODB_URI=mongodb://127.0.0.1:27017/ecosync
# Generate each with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=replace-with-a-long-random-secret
QR_ENCRYPTION_KEY=replace-with-a-different-long-random-secret
# Optional. The classifier adapter needs implementation before results are displayed.
AI_CLASSIFIER_URL=
AI_CLASSIFIER_API_KEY=
# Optional. Authenticates real machine controller events; keep private to the controller.
MACHINE_API_KEY=
AUTHORIZED_MACHINE_IDS=
